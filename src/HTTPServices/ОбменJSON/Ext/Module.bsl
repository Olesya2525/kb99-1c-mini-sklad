
Функция ТоварыМетод1(Запрос)  
	
	МассивТоваров = Новый Массив;
	Выборка = Справочники.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ДанныеТовара = Новый Структура;
		ДанныеТовара.Вставить("code", Выборка.Код);
		ДанныеТовара.Вставить("name", Выборка.Наименование);
		МассивТоваров.Добавить(ДанныеТовара);
	КонецЦикла;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, МассивТоваров);
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

Функция ТоварыМетод2(Запрос)
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(); 
	
	Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
		
		ОтветОшибка = Новый HTTPСервисОтвет(400);
		ОтветОшибка.УстановитьТелоИзСтроки("{""error"":""empty body""}", КодировкаТекста.UTF8);
		Возврат ОтветОшибка; 
		
	КонецЕсли;  
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТелоЗапроса);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Результат = Новый Структура;
	Результат.Вставить("accepted", Истина);
	Результат.Вставить("received", Данные);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат);
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);  
	
	Возврат Ответ;  
	
КонецФункции
