#Область ПрограммныйИнтерфейс

Процедура ОбновлениеИндекса() Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Регламентное задание ОбновлениеИндекса запущено " + ТекущаяДата();
	Сообщение.Сообщить();

	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда 
		
		Если Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда  
			
			ПолнотекстовыйПоиск.ОбновитьИндекс(, Истина);  
			
		КонецЕсли;       
		
	КонецЕсли;

КонецПроцедуры     

Процедура СлияниеИндекса() Экспорт

	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда 
		
		Если Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда                                    
			
			ПолнотекстовыйПоиск.ОбновитьИндекс(Истина);                         
			
		КонецЕсли;                        
		
	КонецЕсли;                                       
	

КонецПроцедуры

Процедура ОбновитьСлужебныеДанные() Экспорт

	СсылкаЭлемента = Справочники.СлужебныеДанные.НайтиПоНаименованию("Контрольная точка", Истина);

	Если СсылкаЭлемента.Пустая() Тогда
		ЭлементОбъект = Справочники.СлужебныеДанные.СоздатьЭлемент();
		ЭлементОбъект.Наименование = "Контрольная точка";
	Иначе
		ЭлементОбъект = СсылкаЭлемента.ПолучитьОбъект();
	КонецЕсли;

	ЭлементОбъект.ДатаОбновления = ТекущаяДата();
	ЭлементОбъект.Комментарий = "Обновлено регламентным заданием " + Формат(ТекущаяДата(), "ДЛФ=DT");
	ЭлементОбъект.Записать();

КонецПроцедуры

