#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	СформироватьДвиженияДокумента();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	НомерСтроки = 0;

	Для Каждого СтрокаТовары Из Товары Цикл

		НомерСтроки = НомерСтроки + 1;
		РасчетнаяСумма = СтрокаТовары.Количество * СтрокаТовары.Цена;

		Если СтрокаТовары.Сумма <> РасчетнаяСумма Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"В строке %1 сумма %2 не равна количеству × цене (%3).",
				НомерСтроки,
				СтрокаТовары.Сумма,
				РасчетнаяСумма);
			Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Сумма";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Движения

Процедура СформироватьДвиженияДокумента()

	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого СтрокаТовары Из Товары Цикл

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Партия = Ссылка;
		Движение.Количество = СтрокаТовары.Количество;
		Движение.Сумма = СтрокаТовары.Сумма;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти