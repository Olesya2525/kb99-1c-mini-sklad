#Область Движения

Процедура СформироватьДвиженияДокумента()

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

	Для Каждого СтрокаТовары Из Товары Цикл

		ДвижениеОстатков = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатков.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатков.Период = Дата;
		ДвижениеОстатков.Товар = СтрокаТовары.Товар;
		ДвижениеОстатков.Количество = СтрокаТовары.Количество;

		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Товар = СтрокаТовары.Товар;
		ДвижениеПродаж.Количество = СтрокаТовары.Количество;
		ДвижениеПродаж.Сумма = СтрокаТовары.Сумма;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти