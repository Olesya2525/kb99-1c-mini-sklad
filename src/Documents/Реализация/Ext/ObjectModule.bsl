#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	СформироватьДвиженияДокумента(Отказ);

КонецПроцедуры

#КонецОбласти

#Область Движения

Процедура СформироватьДвиженияДокумента(Отказ)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

	МоментСписания = МоментВремени();
	НомерСтроки = 0;

	Для Каждого СтрокаТовары Из Товары Цикл

		НомерСтроки = НомерСтроки + 1;

		Если Не КонтролироватьОстатокСтроки(СтрокаТовары, МоментСписания, НомерСтроки, Отказ) Тогда
			Продолжить;
		КонецЕсли;

		СформироватьРасходОстатковПоСтроке(СтрокаТовары, МоментСписания, НомерСтроки, Отказ);

		Если Отказ Тогда
			Продолжить;
		КонецЕсли;

		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Товар = СтрокаТовары.Товар;
		ДвижениеПродаж.Количество = СтрокаТовары.Количество;
		ДвижениеПродаж.Сумма = СтрокаТовары.Сумма;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция КонтролироватьОстатокСтроки(СтрокаТовары, МоментСписания, НомерСтроки, Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар = &Товар) КАК Остатки";

	Запрос.УстановитьПараметр("Момент", МоментСписания);
	Запрос.УстановитьПараметр("Товар", СтрокаТовары.Товар);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Если Не Выборка.Следующий() Тогда
		КоличествоНаСкладе = 0;
	Иначе
		КоличествоНаСкладе = Выборка.КоличествоОстаток;
	КонецЕсли;

	Если КоличествоНаСкладе < СтрокаТовары.Количество Тогда

		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"Недостаточно товара %1: нужно %2, на складе %3",
			СтрокаТовары.Товар,
			СтрокаТовары.Количество,
			КоличествоНаСкладе);
		Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Количество";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Возврат Ложь;

	КонецЕсли;

	Возврат Истина;

КонецФункции

Процедура СформироватьРасходОстатковПоСтроке(СтрокаТовары, МоментСписания, НомерСтроки, Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Партия КАК Партия,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	Остатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар = &Товар) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Остатки.Партия.Дата,
		|	Остатки.Партия.МоментВремени";

	Запрос.УстановитьПараметр("Момент", МоментСписания);
	Запрос.УстановитьПараметр("Товар", СтрокаТовары.Товар);

	ВыборкаПартий = Запрос.Выполнить().Выбрать();
	ОсталосьСписать = СтрокаТовары.Количество;

	Пока ОсталосьСписать > 0 И ВыборкаПартий.Следующий() Цикл

		СписатьКоличество = Мин(ОсталосьСписать, ВыборкаПартий.КоличествоОстаток);

		Если СписатьКоличество = ВыборкаПартий.КоличествоОстаток Тогда
			СписатьСумму = ВыборкаПартий.СуммаОстаток;
		Иначе
			СписатьСумму = СписатьКоличество / ВыборкаПартий.КоличествоОстаток * ВыборкаПартий.СуммаОстаток;
		КонецЕсли;

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Партия = ВыборкаПартий.Партия;
		Движение.Количество = СписатьКоличество;
		Движение.Сумма = СписатьСумму;

		ОсталосьСписать = ОсталосьСписать - СписатьКоличество;

	КонецЦикла;

	Если ОсталосьСписать > 0 Тогда

		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось распределить количество по партиям (FIFO).";
		Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Количество";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

	КонецЕсли;

КонецПроцедуры

#КонецОбласти