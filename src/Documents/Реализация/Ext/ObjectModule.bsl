#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	СформироватьДвиженияДокумента(Отказ);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	НомерСтроки = 0;

	Для Каждого СтрокаТовары Из Товары Цикл

		НомерСтроки = НомерСтроки + 1;
		РасчетнаяСумма = СтрокаТовары.Количество * СтрокаТовары.Цена;

		Если СтрокаТовары.Сумма <> РасчетнаяСумма Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"В строке %1 сумма %2 не равна количеству × цене (%3).",
				НомерСтроки,
				СтрокаТовары.Сумма,
				РасчетнаяСумма);
			Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Сумма";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Движения

Процедура СформироватьДвиженияДокумента(Отказ)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

	МоментСписания = МоментВремени();
	НомерСтроки = 0;
	
	ОстаткиПоТоварам = ПолучитьОстаткиПоТоварамДокумента(МоментСписания);
	
	ТаблицаПартий = ПолучитьПартииДляСписания(МоментСписания);
	
	Для Каждого СтрокаТовары Из Товары Цикл

		НомерСтроки = НомерСтроки + 1;

		Если Не КонтролироватьОстатокСтроки(СтрокаТовары, ОстаткиПоТоварам, НомерСтроки) Тогда
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если Не СформироватьРасходОстатковПоСтроке(СтрокаТовары, ТаблицаПартий, НомерСтроки) Тогда
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		КоличествоНаСкладе = ОстаткиПоТоварам.Получить(СтрокаТовары.Товар);
		Если КоличествоНаСкладе = Неопределено Тогда
			КоличествоНаСкладе = 0;
		КонецЕсли;
		ОстаткиПоТоварам.Вставить(СтрокаТовары.Товар, КоличествоНаСкладе - СтрокаТовары.Количество);
		

		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Товар = СтрокаТовары.Товар;
		ДвижениеПродаж.Количество = СтрокаТовары.Количество;
		ДвижениеПродаж.Сумма = СтрокаТовары.Сумма;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебные 

Функция ПолучитьПартииДляСписания(МоментСписания)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Товар КАК Товар,
		|	Остатки.Партия КАК Партия,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	Остатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар В (&Товары)) КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Поступление КАК Поступления
		|		ПО Остатки.Партия = Поступления.Ссылка
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Остатки.Товар,
		|	Поступления.Дата,
		|	Поступления.МоментВремени";

	Запрос.УстановитьПараметр("Момент", МоментСписания);
	Запрос.УстановитьПараметр("Товары", Товары.ВыгрузитьКолонку("Товар"));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьОстаткиПоТоварамДокумента(МоментСписания)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Товар КАК Товар,
		|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар В (&Товары)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Товар";

	Запрос.УстановитьПараметр("Момент", МоментСписания);
	Запрос.УстановитьПараметр("Товары", Товары.ВыгрузитьКолонку("Товар"));

	ОстаткиПоТоварам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ОстаткиПоТоварам.Вставить(Выборка.Товар, Выборка.КоличествоОстаток);
	КонецЦикла;

	Возврат ОстаткиПоТоварам;

КонецФункции

Функция КонтролироватьОстатокСтроки(СтрокаТовары, ОстаткиПоТоварам, НомерСтроки)
	КоличествоНаСкладе = ОстаткиПоТоварам.Получить(СтрокаТовары.Товар);
	Если КоличествоНаСкладе = Неопределено Тогда
		КоличествоНаСкладе = 0;
	КонецЕсли;
	Если КоличествоНаСкладе < СтрокаТовары.Количество Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"Недостаточно товара %1: нужно %2, на складе %3",
			СтрокаТовары.Товар,
			СтрокаТовары.Количество,
			КоличествоНаСкладе);
		Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Количество";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Возврат Ложь;

	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция СформироватьРасходОстатковПоСтроке(СтрокаТовары, ТаблицаПартий, НомерСтроки)
	
	ОсталосьСписать = СтрокаТовары.Количество;

	ОсталосьСписать = СтрокаТовары.Количество;

	Для Каждого СтрокаПартии Из ТаблицаПартий Цикл

		Если ОсталосьСписать = 0 Тогда
			Прервать;
		КонецЕсли;

		Если СтрокаПартии.Товар <> СтрокаТовары.Товар Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПартии.КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СписатьКоличество = Мин(ОсталосьСписать, СтрокаПартии.КоличествоОстаток);

		Если СписатьКоличество = СтрокаПартии.КоличествоОстаток Тогда
			СписатьСумму = СтрокаПартии.СуммаОстаток;
		Иначе
			СписатьСумму = СписатьКоличество / СтрокаПартии.КоличествоОстаток * СтрокаПартии.СуммаОстаток;
		КонецЕсли;

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Партия = СтрокаПартии.Партия;
		Движение.Количество = СписатьКоличество;
		Движение.Сумма = СписатьСумму;

		СтрокаПартии.КоличествоОстаток = СтрокаПартии.КоличествоОстаток - СписатьКоличество;
		СтрокаПартии.СуммаОстаток = СтрокаПартии.СуммаОстаток - СписатьСумму;
		ОсталосьСписать = ОсталосьСписать - СписатьКоличество;

	КонецЦикла;

	Если ОсталосьСписать > 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось распределить количество по партиям (FIFO).";
		Сообщение.Поле = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=") + "].Количество";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();      
		
        Возврат Ложь;

	КонецЕсли;    
	
	Возврат Истина;

КонецФункции

#КонецОбласти